{
    "name": "edulazaro/wirebug",
    "description": "Drop-in floating bug/feedback report widget for Laravel apps. Themeable through the wire* family CSS variables — shares look with wiremodal, wiretoast and wirecookies.",
    "type": "library",
    "keywords": ["laravel", "bug", "feedback", "report", "widget", "blade", "alpine"],
    "license": "MIT",
    "authors": [
        {
            "name": "Edu Lazaro",
            "email": "eduzro@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "edulazaro/wiremodal": "^1.1",
        "illuminate/support": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "EduLazaro\\WireBug\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EduLazaro\\WireBug\\WireBugServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
